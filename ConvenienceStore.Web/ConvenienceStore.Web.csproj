<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ConvenienceStore-Web-Local-Development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConvenienceStore.Business\ConvenienceStore.Business.csproj" />
    <ProjectReference Include="..\ConvenienceStore.Models\ConvenienceStore.Models.csproj" />
  </ItemGroup>

  <!-- Compile the five standalone Member 2 security modules from the repository root folder. -->
  <ItemGroup>
    <Compile Include="..\baomatbackend\*.cs" Link="BaoMatBackend\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.34">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MimeKit" Version="4.18.2" />
  </ItemGroup>

</Project>

@model ConvenienceStore.Web.ViewModels.ComboKhuyenMaiFormViewModel

@{
    var laChinhSua = Model.Id > 0;
    ViewData["Title"] = laChinhSua ? "Cập nhật combo" : "Tạo combo";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-form-card">
    <div class="admin-page-header mb-4">
        <div>
            <h2>@ViewData["Title"]</h2>
            <p>Chọn từ 2 sản phẩm trở lên và đặt giá bán chung cho combo</p>
        </div>
    </div>

    <form asp-action="Combo" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TenCombo" class="form-label">Tên combo</label>
                <input asp-for="TenCombo" class="form-control admin-input" placeholder="Ví dụ: Combo ăn vặt 1/6" />
                <span asp-validation-for="TenCombo" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="GiaCombo" class="form-label">Giá combo</label>
                <input asp-for="GiaCombo" class="form-control admin-input" min="1000" />
                <span asp-validation-for="GiaCombo" class="text-danger"></span>
            </div>

            <div class="col-md-3 mb-3">
                <label class="form-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-select admin-input">
                    <option value="true">Đang bán</option>
                    <option value="false">Tạm ngưng</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MoTa" class="form-label">Mô tả</label>
            <textarea asp-for="MoTa" class="form-control admin-input" rows="3" placeholder="Ghi chú ngắn cho combo"></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Sản phẩm trong combo</label>
            <span asp-validation-for="SanPhamIds" class="text-danger d-block mb-2"></span>

            <div class="combo-product-grid">
                @foreach (var item in Model.DanhSachSanPham)
                {
                    <label class="combo-product-option">
                        @if (item.DuocChon)
                        {
                            <input type="checkbox" name="SanPhamIds" value="@item.Id" checked />
                        }
                        else
                        {
                            <input type="checkbox" name="SanPhamIds" value="@item.Id" />
                        }
                        <span class="combo-product-check">
                            <i class="fa-solid fa-check"></i>
                        </span>
                        <span class="combo-product-name">@item.TenSanPham</span>
                        <span class="combo-product-price">@item.Gia.ToString("N0") đ</span>
                    </label>
                }
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn admin-primary-btn">
                @(laChinhSua ? "Lưu combo" : "Tạo combo")
            </button>
            <a asp-action="Index" class="btn admin-secondary-btn">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

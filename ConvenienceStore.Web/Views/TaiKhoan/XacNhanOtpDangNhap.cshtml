@{
    ViewData["Title"] = "Xác thực OTP đăng nhập";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Xác thực hai yếu tố</h2>
            <p>Nhập mã OTP được gửi đến email của bạn để hoàn tất đăng nhập.</p>
        </div>

        <form asp-action="XacNhanOtpDangNhap" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="form-group mb-3">
                <label for="otp" class="form-label">Mã OTP 6 chữ số</label>
                <input id="otp" name="otp" class="form-control auth-input" inputmode="numeric"
                       autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
            </div>
            <p class="text-muted small">Mã có hiệu lực trong 5 phút và tối đa 5 lần nhập sai.</p>
            <button type="submit" class="btn auth-btn w-100">Xác nhận đăng nhập</button>
        </form>
    </div>
</div>
